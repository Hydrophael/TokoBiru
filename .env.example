# --- Database dan aplikasi ---
# Lokal boleh kosong (default mongodb://localhost:27017). Di Vercel wajib diisi
MONGO_URI=
# Nama database (default tokobiru)
MONGO_DB=
# String acak panjang. Di Vercel wajib diisi
SECRET_KEY=
# Alamat publik toko, contoh: https://tokobiru.vercel.app (untuk tautan kembali dari e-wallet)
PUBLIC_URL=
# Lama log aktivitas disimpan, dalam hari (default 90)
LOG_RETENTION_DAYS=

# --- Akun master otomatis saat deploy (dibuat bila belum ada) ---
MASTER_USERNAME=
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME=

# --- Pesanan ---
# Rekening tujuan transfer yang tampil di pesanan, contoh: BCA 1234567890 a.n. TokoBiru
# Bila kosong, pilihan "Transfer bank" tidak ditawarkan
PAY_INFO=
# Batas jam bayar sebelum pesanan belum dibayar dibatalkan otomatis (default 24)
PENDING_TTL_HOURS=
# Jumlah pesanan belum dibayar per pelanggan (default 3)
MAX_PENDING_ORDERS=
# Pesanan tunai (COD): batas jam menunggu diproses toko (default 72)
COD_TTL_HOURS=
# Berapa jam sebelum batas COD habis staf diingatkan (default 12)
COD_REMIND_HOURS=
# Jumlah pesanan COD yang menunggu diproses per pelanggan (default 5)
MAX_PENDING_COD_ORDERS=
# Jam sebelum staf diingatkan bahwa bukti transfer belum dicek (default 12)
PROOF_REMIND_HOURS=
# Ongkir flat (default 10000, isi 0 untuk gratis)
SHIPPING_FEE=
# Belanja minimal gratis ongkir (default 0 = tidak ada)
FREE_SHIPPING_MIN=

# --- QRIS ---
# QRIS simulasi untuk demo (isi 1/true/ya/on). Kosongkan di toko sungguhan
DUMMY_QRIS=
# Batas bayar QRIS dalam menit (default 60)
QRIS_TTL_MINUTES=

# --- Xendit (QRIS asli dan e-wallet) ---
# Isi kedua kunci untuk mengaktifkan; DUMMY_QRIS otomatis mati
# Uji: xnd_development_... | Live: xnd_production_... (jangan dicampur di environment yang sama)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Batas bayar e-wallet dalam menit. Default: DANA 60, ShopeePay 30, OVO 15
# Jangan lebih pendek dari umur tagihan di Xendit (ShopeePay 30 menit, DANA 24 jam)
DANA_TTL_MINUTES=
SHOPEEPAY_TTL_MINUTES=
OVO_TTL_MINUTES=

# --- Email kode "Lupa password" ---
# Port 587 (STARTTLS) atau 465 (SSL). Kosongkan SMTP_HOST bila tidak dipakai
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Notifikasi push untuk admin/master (butuh pywebpush) ---
# Buat kunci dengan: python app.py gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Isi dengan emailmu, contoh: mailto:kamu@gmail.com
VAPID_SUBJECT=

# --- Baca bukti transfer otomatis oleh Google Gemini ---
# Kosongkan GEMINI_API_KEY bila tidak dipakai
GEMINI_API_KEY=
# Model yang membaca foto bukti (default gemini-3.5-flash-lite)
PROOF_READER_MODEL=
# Model cadangan bila model utama sibuk (503) atau kuotanya habis (429).
# Default gemini-3.1-flash-lite, kosongkan untuk mematikan cadangan
PROOF_READER_FALLBACK_MODEL=
# Bacaan yang menentukan dibaca dua kali oleh model berbeda (default 1; isi 0 untuk mematikan)
PROOF_CONFIRM_READ=
# Ciri rekening tujuan yang benar: 4 digit terakhir dan/atau nama pemilik, pisahkan koma.
# Contoh: 4821,TokoBiru. Kosong = rekening tujuan tidak diperiksa
PROOF_BANK_HINT=
# Batas waktu baca saat pelanggan mengunggah, dalam detik (default 6, minimal 3)
PROOF_UPLOAD_TIMEOUT=
# Batas waktu baca saat staf menekan tombol baca manual, dalam detik (default 20, minimal 5)
PROOF_STAFF_TIMEOUT=
# Lama foto bukti transfer disimpan dalam hari, lalu dihapus otomatis (default 90)
PROOF_RETENTION_DAYS=
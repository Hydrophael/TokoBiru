MONGO_URI=
MONGO_DB=
SECRET_KEY=
# buat akun master otomatis saat deploy
MASTER_USERNAME=
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME=
# Opsional: instruksi bayar yang tampil di pesanan pelanggan
PAY_INFO=
PENDING_TTL_HOURS=
# batas pesanan belum dibayar per pelanggan (default 3)
MAX_PENDING_ORDERS=
# ongkir flat (default 10000, isi 0 untuk gratis) dan belanja minimal gratis ongkir
SHIPPING_FEE=
FREE_SHIPPING_MIN=
LOG_RETENTION_DAYS=
# server email untuk kode "Lupa password" (port 587 atau 465). Kosongkan bila tidak dipakai
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# QRIS simulasi untuk demo, kosongkan di toko sungguhan
DUMMY_QRIS=
QRIS_TTL_MINUTES=

# QRIS asli lewat Xendit. Isi keduanya untuk mengaktifkan; DUMMY_QRIS otomatis mati.
# Uji: xnd_development_... | Live: xnd_production_... (jangan dicampur di environment yang sama)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# E-wallet (DANA/ShopeePay/OVO) ikut kunci Xendit di atas.
# Batas bayar tiap e-wallet dalam menit. Default: DANA 60, ShopeePay 30, OVO 15.
# Jangan lebih pendek dari umur tagihan di Xendit (ShopeePay 30 menit, DANA 24 jam).
DANA_TTL_MINUTES=
SHOPEEPAY_TTL_MINUTES=
OVO_TTL_MINUTES=
# Alamat publik toko
PUBLIC_URL=

# Notifikasi push pesanan untuk admin/master (butuh paket pywebpush di requirements.txt).
# Buat kunci dengan: python app.py gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# isi dengan emailmu, contoh: mailto:kamu@gmail.com
VAPID_SUBJECT=

# Baca bukti transfer otomatis oleh Google Gemini
# Kosongkan GEMINI_API_KEY bila tidak dipakai.
GEMINI_API_KEY=
# Model bergambar yang membaca foto 
PROOF_READER_MODEL=
# Ciri rekening tujuan yang benar: 4 digit terakhir dan/atau nama pemilik, pisahkan koma. Contoh: 4821,TokoBiru
PROOF_BANK_HINT=
# Lama foto bukti transfer disimpan (hari), lalu dihapus otomatis. Kosong = 90.
PROOF_RETENTION_DAYS=